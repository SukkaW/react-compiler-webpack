{
  "name": "react-compiler-webpack",
  "version": "1.0.0",
  "description": "The webpack/Next.js Plugin for React Compiler",
  "repository": "https://github.com/SukkaW/react-compiler-webpack",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "next.js"
  ],
  "scripts": {
    "lint": "eslint --format=sukka .",
    "build": "rollup -c rollup.config.ts --configPlugin swc3 --bundleConfigAsCjs",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "mocha -r @swc-node/register 'test/index.ts'",
    "test:update": "UPDATE_SNAPSHOT=all mocha -r @swc-node/register 'test/index.ts'",
    "prerelease": "pnpm run build && pnpm run lint",
    "release": "bumpp -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [
    "react",
    "react-forget",
    "react-compiler",
    "webpack-loader",
    "webpack",
    "nextjs",
    "app-router"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@babel/plugin-syntax-typescript": "^7.28.6"
  },
  "devDependencies": {
    "@eslint-sukka/node": "^8.10.3",
    "@rspack/core": "^1.7.11",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@types/babel__core": "^7.20.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "browserslist": "^4.28.2",
    "bumpp": "^10.4.1",
    "earl": "^2.0.0",
    "eslint": "^10.4.0",
    "eslint-config-sukka": "^8.10.3",
    "eslint-formatter-sukka": "^8.10.3",
    "expect": "^30.4.1",
    "foxts": "^5.4.2",
    "memfs": "^5.0.0-next.1",
    "mocha": "^11.7.5",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-swc3": "^0.12.1",
    "swc-loader": "^0.2.7",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2"
  },
  "peerDependencies": {
    "babel-plugin-react-compiler": "*"
  },
  "packageManager": "pnpm@11.1.2"
}
