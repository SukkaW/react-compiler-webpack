{
  "name": "react-compiler-webpack",
  "version": "1.1.0",
  "description": "The webpack/Next.js Plugin for React Compiler",
  "repository": "https://github.com/SukkaW/react-compiler-webpack",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "next.js"
  ],
  "scripts": {
    "lint": "eslint --format=sukka .",
    "build": "rollup -c rollup.config.ts --configPlugin swc3 --bundleConfigAsCjs",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "mocha -r @swc-node/register 'test/index.ts'",
    "test:update": "UPDATE_SNAPSHOTS=true mocha -r @swc-node/register 'test/index.ts'",
    "prerelease": "pnpm run build && pnpm run lint",
    "release": "bumpp -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [
    "react",
    "react-forget",
    "react-compiler",
    "webpack-loader",
    "webpack",
    "nextjs",
    "app-router"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3"
  },
  "devDependencies": {
    "@eslint-sukka/node": "^9.0.1",
    "@rspack/core": "^2.2.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/babel__core": "^7.20.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserslist": "^4.28.9",
    "bumpp": "^10.4.1",
    "earl": "^2.0.0",
    "eslint": "^10.10.0",
    "eslint-config-sukka": "^9.0.1",
    "eslint-formatter-sukka": "^9.0.1",
    "expect": "^30.5.1",
    "foxts": "^5.9.1",
    "memfs": "^5.0.0-next.1",
    "mocha": "^12.0.0",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-swc3": "^0.12.1",
    "swc-loader": "^0.2.7",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4"
  },
  "peerDependencies": {
    "babel-plugin-react-compiler": "*"
  },
  "packageManager": "pnpm@11.25.0"
}
